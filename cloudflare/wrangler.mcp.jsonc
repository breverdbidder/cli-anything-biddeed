{
  // biddeed-mcp-production — #20025 EXIT VERCEL A
  // mcp.biddeed.ai byte-equivalent replacement for the retired Vercel function.
  "name": "biddeed-mcp-production",
  "main": "mcp-worker.mjs",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  // Plan probe result (run 33965846032, 2026-09-05 12:22 UTC): Cloudflare rejected
  // `limits.cpu_ms` with code 100328 "CPU limits are not supported for the Free plan".
  // The account is on Workers FREE. Vercel disabled the deployment the same minute
  // (402 DEPLOYMENT_DISABLED on mcp.biddeed.ai), so the block is removed to restore
  // service on Free now; the $5/mo Workers Paid decision (needed for reliable PDF
  // generation under the 10 ms CPU cap) is surfaced to Ariel, not taken here.
  //
  // Cutover 2026-09-05 (chat, DNS-scoped token): the Vercel CNAME on mcp.biddeed.ai was
  // replaced by a proxied placeholder A record (192.0.2.1) so this zone route receives
  // the traffic — same pattern biddeed.ai itself uses (proxied record + Worker route).
  // Rollback: docs/spec/20025-rollback.md.
  "routes": [
    { "pattern": "mcp.biddeed.ai/*", "zone_name": "biddeed.ai" }
  ],
  "vars": {
    // Same value the Vercel function carried (public URL, not a secret).
    "MCP_PUBLIC_URL": "https://mcp.biddeed.ai"
  },
  "observability": { "enabled": true },
  // LAUNCH-A (#20035): Workers Rate Limiting binding (available on Free plan,
  // unlike WAF custom rules which need Pro+). Per-IP unauth 20 req/60s,
  // per-API-key (sha256 of bearer) 120 req/60s. Enforced in mcp-worker.mjs.
  // GA top-level `ratelimits` config (wrangler >=4.36.0) — the older
  // `unsafe.bindings type=ratelimit` path deployed clean but its limit()
  // calls always returned success:true against live traffic (verified via a
  // temporary debug header, 85 requests, zero throttling); this is the
  // documented-current, non-experimental config.
  "ratelimits": [
    { "name": "RATE_LIMITER_IP", "namespace_id": "20035001", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMITER_KEY", "namespace_id": "20035002", "simple": { "limit": 120, "period": 60 } }
  ]
}
