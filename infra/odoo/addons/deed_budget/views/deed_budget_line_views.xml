<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="deed_budget_line_view_list" model="ir.ui.view">
        <field name="name">deed.budget.line.list</field>
        <field name="model">deed.budget.line</field>
        <field name="arch" type="xml">
            <list string="Deed Budget Lines">
                <field name="name"/>
                <field name="analytic_account_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="planned_amount"/>
                <field name="actual_amount"/>
                <field name="variance_amount"/>
            </list>
        </field>
    </record>

    <record id="deed_budget_line_view_form" model="ir.ui.view">
        <field name="name">deed.budget.line.form</field>
        <field name="model">deed.budget.line</field>
        <field name="arch" type="xml">
            <form string="Deed Budget Line">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="analytic_account_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="planned_amount"/>
                        <field name="actual_amount" readonly="1"/>
                        <field name="variance_amount" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="deed_budget_line_action" model="ir.actions.act_window">
        <field name="name">Budget Lines</field>
        <field name="res_model">deed.budget.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_deed_budget_line"
              name="Budgets"
              parent="project.menu_main_pm"
              action="deed_budget_line_action"
              sequence="60"/>
</odoo>
