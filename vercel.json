{
  "version": 2,
  "name": "biddeed-mcp",
  "framework": null,
  "installCommand": "cd packages/biddeed-mcp && npm install",
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/stripe/webhook.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/mcp/(.*)", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/mcp" },
    { "source": "/report/pdf", "destination": "/api/mcp" },
    { "source": "/report/json", "destination": "/api/mcp" }
  ]
}
