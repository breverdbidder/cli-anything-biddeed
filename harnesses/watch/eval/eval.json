{
  "name": "Claude Watch — AUTOLOOP Eval",
  "version": "0.1.0",
  "assertions": [
    {
      "id": 1,
      "group": "EDGE FUNCTION",
      "description": "Returns 401 for missing Authorization header",
      "type": "http",
      "method": "POST",
      "path": "/functions/v1/watch-ingest",
      "expected_status": 401
    },
    {
      "id": 2,
      "group": "EDGE FUNCTION",
      "description": "Returns 401 for invalid bearer token",
      "type": "http",
      "method": "POST",
      "path": "/functions/v1/watch-ingest",
      "headers": { "Authorization": "Bearer invalid-token-xyz" },
      "expected_status": 401
    },
    {
      "id": 3,
      "group": "EDGE FUNCTION",
      "description": "Returns 400 for non-JSON body",
      "type": "http",
      "method": "POST",
      "path": "/functions/v1/watch-ingest",
      "body_raw": "not-json",
      "expected_status": 400
    },
    {
      "id": 4,
      "group": "EDGE FUNCTION",
      "description": "Returns 400 for missing session_id",
      "type": "http",
      "method": "POST",
      "path": "/functions/v1/watch-ingest",
      "body": { "type": "PostToolUse", "tool_name": "Read" },
      "expected_status": 400
    },
    {
      "id": 5,
      "group": "EDGE FUNCTION",
      "description": "Returns 200 for valid PostToolUse payload",
      "type": "http",
      "method": "POST",
      "path": "/functions/v1/watch-ingest",
      "body": {
        "session_id": "eval-test-001",
        "type": "PostToolUse",
        "tool_name": "Read",
        "project_path": "/home/user/repos/biddeed-ai",
        "tool_input": { "file_path": "/home/user/repos/biddeed-ai/src/index.ts" }
      },
      "expected_status": 200
    },
    {
      "id": 6,
      "group": "EDGE FUNCTION",
      "description": "Creates session on first event for new session_id",
      "type": "db_query",
      "table": "watch_sessions",
      "filter": "id=eq.eval-test-001",
      "expected_count": 1
    },
    {
      "id": 7,
      "group": "EDGE FUNCTION",
      "description": "Increments event_count on subsequent events",
      "type": "db_query",
      "table": "watch_sessions",
      "filter": "id=eq.eval-test-001",
      "field": "event_count",
      "expected_min": 2
    },
    {
      "id": 8,
      "group": "EDGE FUNCTION",
      "description": "Sets status=completed on Stop hook_type",
      "type": "http",
      "method": "POST",
      "path": "/functions/v1/watch-ingest",
      "body": {
        "session_id": "eval-test-001",
        "type": "Stop"
      },
      "expected_status": 200,
      "then_check": {
        "table": "watch_sessions",
        "filter": "id=eq.eval-test-001",
        "field": "status",
        "expected_value": "completed"
      }
    },
    {
      "id": 9,
      "group": "EDGE FUNCTION",
      "description": "Generates summary on session completion",
      "type": "db_query",
      "table": "watch_sessions",
      "filter": "id=eq.eval-test-001",
      "field": "summary",
      "expected_not_null": true
    },
    {
      "id": 10,
      "group": "EDGE FUNCTION",
      "description": "Extracts relative file_path from absolute path",
      "type": "db_query",
      "table": "watch_events",
      "filter": "session_id=eq.eval-test-001&tool_name=eq.Read",
      "field": "file_path",
      "expected_value": "src/index.ts"
    },
    {
      "id": 11,
      "group": "EDGE FUNCTION",
      "description": "Extracts diff from Edit tool input",
      "type": "integration",
      "steps": [
        {
          "http_post": "/functions/v1/watch-ingest",
          "body": {
            "session_id": "eval-diff-001",
            "type": "PostToolUse",
            "tool_name": "Edit",
            "project_path": "/repos/test",
            "tool_input": {
              "file_path": "/repos/test/src/foo.ts",
              "old_string": "const x = 1;",
              "new_string": "const x = 2;"
            }
          }
        },
        {
          "db_query": "watch_events",
          "filter": "session_id=eq.eval-diff-001&tool_name=eq.Edit",
          "field": "diff",
          "expected_contains": "--- old"
        }
      ]
    },
    {
      "id": 12,
      "group": "EDGE FUNCTION",
      "description": "Caps output_data at 50KB",
      "type": "unit",
      "note": "Edge function internal: new TextEncoder().encode(raw).length > 51200 → truncate"
    },
    {
      "id": 13,
      "group": "DATABASE",
      "description": "RLS blocks unauthenticated SELECT on watch_sessions",
      "type": "http",
      "method": "GET",
      "path": "/rest/v1/watch_sessions",
      "auth": "anon",
      "expected_status": 200,
      "expected_count": 0,
      "note": "anon key with RLS returns empty array, not 401"
    },
    {
      "id": 14,
      "group": "DATABASE",
      "description": "RLS blocks unauthenticated SELECT on watch_events",
      "type": "http",
      "method": "GET",
      "path": "/rest/v1/watch_events",
      "auth": "anon",
      "expected_status": 200,
      "expected_count": 0
    },
    {
      "id": 15,
      "group": "DATABASE",
      "description": "RLS allows authenticated SELECT on watch_sessions",
      "type": "http",
      "method": "GET",
      "path": "/rest/v1/watch_sessions",
      "auth": "service_role",
      "expected_status": 200
    },
    {
      "id": 16,
      "group": "DATABASE",
      "description": "Foreign key cascade deletes events when session deleted",
      "type": "db_query",
      "note": "DELETE FROM watch_sessions WHERE id=X should cascade to watch_events"
    },
    {
      "id": 17,
      "group": "DATABASE",
      "description": "pg_cron retention deletes events older than 30 days",
      "type": "db_query",
      "sql": "SELECT jobname FROM cron.job WHERE jobname = 'watch-retention'",
      "expected_count": 1
    },
    {
      "id": 18,
      "group": "HEALTH SCANNER",
      "description": "Classifies CLAUDE.md as category=rules",
      "type": "unit",
      "input": { "filename": "CLAUDE.md", "content": "# Rules\nNEVER do X\nALWAYS do Y" },
      "expected_category": "rules"
    },
    {
      "id": 19,
      "group": "HEALTH SCANNER",
      "description": "Classifies .cursorrules as category=prompt",
      "type": "unit",
      "input": { "filename": ".cursorrules", "content": "You are a helpful assistant" },
      "expected_category": "prompt"
    },
    {
      "id": 20,
      "group": "HEALTH SCANNER",
      "description": "Detects NEVER keyword as importance=critical",
      "type": "unit",
      "input": { "content": "NEVER run rm -rf\nNEVER delete production\nNEVER expose secrets" },
      "expected_importance": "critical"
    },
    {
      "id": 21,
      "group": "HEALTH SCANNER",
      "description": "Skips node_modules directory",
      "type": "unit",
      "note": "SKIP_DIRS includes node_modules — scanner must not traverse it"
    },
    {
      "id": 22,
      "group": "HEALTH SCANNER",
      "description": "Computes consistent SHA-256 for same content",
      "type": "unit",
      "input": "hello world",
      "expected": "b94d27b9934d3e08a52e52d7da7dabfac484efe04294e576de24f3b8d3ec5ef4"
    },
    {
      "id": 23,
      "group": "HEALTH SCANNER",
      "description": "Caps file scan at 100KB",
      "type": "unit",
      "note": "Files larger than 102400 bytes must be skipped or truncated"
    },
    {
      "id": 24,
      "group": "DASHBOARD",
      "description": "Login page renders without auth",
      "type": "e2e",
      "url": "https://watch.biddeed.ai",
      "expected_element": "input[type=email]",
      "auth": "none"
    },
    {
      "id": 25,
      "group": "DASHBOARD",
      "description": "Session list requires authentication",
      "type": "e2e",
      "url": "https://watch.biddeed.ai/audit",
      "expected_redirect": "https://watch.biddeed.ai",
      "auth": "none"
    }
  ]
}
