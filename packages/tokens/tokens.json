      "secondary": { "hex": "#1C2434", "hsl": "222 30% 16%" },
      "muted": { "hex": "#1C2434", "hsl": "222 30% 16%" },
      "mutedForeground": { "hex": "#A39C93", "hsl": "30 8% 63%" },
      "border": { "hex": "#232B3A", "hsl": "222 24% 19%" }
