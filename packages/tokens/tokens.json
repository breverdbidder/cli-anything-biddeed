      "secondary": { "hex": "#EDE3D7", "hsl": "35 35% 89%" },
      "muted": { "hex": "#EDE3D7", "hsl": "35 35% 89%" },
      "mutedForeground": { "hex": "#766F67", "hsl": "28 8% 45%", "note": "measured 4.37:1 on background — a near-miss under strict 4.5:1 AA; see docs/spec/19828.md residuals" },
      "border": { "hex": "#DDD5C9", "hsl": "33 25% 82%" },
