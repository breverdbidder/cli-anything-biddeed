    },
    "display": {
      "family": "Newsreader",
      "cssVar": "--font-display",
      "fallback": ["Iowan Old Style", "Palatino Linotype", "Georgia", "serif"],
      "note": "headline serif, biddeed-web only as of 2026-09-04 — not yet loaded on Worker-rendered pages, see docs/spec/19828.md residuals"
    },
    "mono": {
      "family": "JetBrains Mono",
      "note": "financial/tabular data only, per CLAUDE.md Design System section"
    },
    "sizeScale": [12, 14, 16, 18, 20, 24, 30, 36, 48, 60],
    "numericVariant": "tabular-nums"
  },
