---
// Reserved voice-agent entry point. Today this just opens a tel: link.
// TODO(Vapi integration): when PUBLIC_VAPI_PUBLIC_KEY is set, swap the tel:
// anchor for the Vapi web SDK's <vapi-widget> / assistant-launch call here.
// Do NOT wire this live in this issue -- see #19405 non-goals.
import { PHONE_TEL, PHONE_DISPLAY } from "../config/site";

interface Props {
  class?: string;
  label?: string;
}
const { class: className = "", label = "Talk to us" } = Astro.props;
const vapiKey = import.meta.env.PUBLIC_VAPI_PUBLIC_KEY;
---

<a
  href={PHONE_TEL}
  data-voice-widget
  data-vapi-ready={vapiKey ? "true" : "false"}
  class:list={[
    "inline-flex items-center gap-2 rounded-none border border-brass px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-brass",
    className,
  ]}
  aria-label={`${label}: call ${PHONE_DISPLAY}`}
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
  </svg>
  {label}
</a>

<!--
  When PUBLIC_VAPI_PUBLIC_KEY is present at build time, this hook is where the
  Vapi web snippet gets mounted. Left inert on purpose -- see TODO above.
-->
{vapiKey && (
  <script is:inline define:vars={{ vapiKey }}>
    // TODO(Vapi live integration): mount web SDK against `vapiKey` here.
    console.info("[VoiceWidget] PUBLIC_VAPI_PUBLIC_KEY present -- Vapi SDK mount point ready, not yet wired.");
  </script>
)}
