---
import Layout from "../layouts/Layout.astro";
import VoiceWidget from "../components/VoiceWidget.astro";

const lines = [
  { title: "Homeowners", body: "Single-family, condo, and rental dwelling coverage sized to Florida wind and flood exposure — not a copy-paste national template." },
  { title: "Personal auto", body: "Liability, collision, and comprehensive for your household vehicles, with real bundling discounts when paired with home." },
  { title: "Renters", body: "Fast, affordable coverage for tenants — often quoted same-day." },
  { title: "Personal umbrella", body: "Extra liability limits above your home and auto policies for households with real assets to protect." },
  { title: "Flood", body: "Where indicated by your location, flood is quoted alongside your homeowners policy — not left for you to discover later." },
  { title: "Boat & recreational", body: "Coverage for the boat, the trailer, and the weekend — for Florida households that actually use the water." },
];
---

<Layout
  title="Personal Lines Insurance"
  description="Home, auto, umbrella, and flood coverage for Florida households, quoted fast by licensed producers who bind every policy themselves."
>
  <section class="border-b border-ink/10 bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-widest text-brass">Personal lines</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl leading-tight text-ink sm:text-5xl">
        Home, auto, and umbrella coverage that fits Florida, not a national template.
      </h1>
      <p class="mt-5 max-w-xl text-slate">
        Florida homeowners deal with risk most states don't — wind, flood,
        and a hard insurance market. We quote against carriers who actually
        write Florida risk, and a licensed producer walks you through it
        before you sign anything.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/get-a-quote"
          class="inline-flex items-center justify-center bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-brass hover:text-ink"
        >
          Get a Quote →
        </a>
        <VoiceWidget />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-2xl text-ink sm:text-3xl">Coverage we quote</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {lines.map((l) => (
        <div class="border border-ink/10 bg-white/40 p-6">
          <h3 class="font-display text-lg text-ink">{l.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">{l.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink/10 bg-ink py-16 text-paper">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl sm:text-3xl">Five minutes, one form, a real call back</h2>
      <p class="mx-auto mt-4 max-w-2xl text-paper/75">
        No mega-menu of product pages to dig through. Tell us about your
        household once and a licensed Florida producer takes it from there.
      </p>
      <a
        href="/get-a-quote"
        class="mt-8 inline-flex items-center justify-center bg-brass px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-brass-light"
      >
        Start your quote →
      </a>
    </div>
  </section>
</Layout>
