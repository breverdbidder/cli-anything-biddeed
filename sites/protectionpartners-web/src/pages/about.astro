---
import Layout from "../layouts/Layout.astro";
import { AGENCY_CITY, LICENSE_LINE, PHONE_DISPLAY, PHONE_TEL } from "../config/site";

const team = [
  {
    initials: "MS",
    name: "Mariam Shapira",
    role: "Founder & Licensed Producer",
    bio: "Mariam founded Protection Partners to fix the two things that frustrate Florida business owners most about buying insurance: slow intake and CSRs who don't understand the risk. She personally reviews commercial and business auto submissions before they're quoted.",
  },
  {
    initials: "TBD",
    name: "[Producer name — TBD]",
    role: "Licensed Producer, Personal Lines",
    bio: "[Bio pending — Ariel/Mariam to provide.]",
  },
];
---

<Layout
  title="About & Contact"
  description="Meet the licensed Florida producers behind Protection Partners, based in Titusville, FL."
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-brass">About</p>
    <h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">
      An agency built by people who quote it themselves.
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-slate">
      Protection Partners is an independent Florida insurance agency based in
      {AGENCY_CITY}. We specialize in commercial and business auto coverage,
      with a full personal lines practice alongside it. Every submission —
      whether it starts with our AI-assisted intake or a phone call — is
      reviewed, quoted, and bound by a licensed Florida producer. We built
      the AI-native part to remove the slow, repetitive parts of insurance
      shopping, not the human judgment.
    </p>
  </section>

  <section class="border-t border-ink/10 bg-paper-2 py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="font-display text-2xl text-ink">Team</h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-2">
        {team.map((member) => (
          <div class="border border-ink/10 bg-white/60 p-6">
            <div class="flex h-14 w-14 items-center justify-center border border-brass font-display text-lg text-ink">
              {member.initials}
            </div>
            <h3 class="mt-4 font-display text-lg text-ink">{member.name}</h3>
            <p class="text-sm font-semibold text-brass">{member.role}</p>
            <p class="mt-2 text-sm leading-relaxed text-slate">{member.bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-2xl text-ink">Contact</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2">
      <div class="border border-ink/10 bg-white/40 p-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-brass">Phone</p>
        <a href={PHONE_TEL} class="mt-2 block font-display text-xl text-ink hover:text-brass">
          {PHONE_DISPLAY}
        </a>
      </div>
      <div class="border border-ink/10 bg-white/40 p-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-brass">Office</p>
        <p class="mt-2 text-ink">{AGENCY_CITY}</p>
        <p class="mt-1 text-sm text-slate">{LICENSE_LINE}</p>
      </div>
    </div>
    <a
      href="/get-a-quote"
      class="mt-8 inline-flex items-center justify-center bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-brass hover:text-ink"
    >
      Get a Quote →
    </a>
  </section>
</Layout>
