---
import Layout from "../layouts/Layout.astro";
import VoiceWidget from "../components/VoiceWidget.astro";

const coverages = [
  {
    title: "Commercial auto & fleet",
    body: "Single vehicle to multi-truck fleets — liability, physical damage, and hired/non-owned auto for operations that can't afford a lapse.",
  },
  {
    title: "General liability",
    body: "Premises, operations, and products liability sized to how your business actually operates, not a generic template limit.",
  },
  {
    title: "Business owners policy (BOP)",
    body: "Property and liability bundled for eligible small-to-midsize operations — one policy instead of three.",
  },
  {
    title: "Workers' compensation",
    body: "Florida-compliant coverage for crews, contractors, and mixed-classification workforces.",
  },
  {
    title: "Commercial property",
    body: "Buildings, equipment, and inventory — including builder's risk for active renovation or construction projects.",
  },
  {
    title: "Umbrella / excess liability",
    body: "Extra limits layered over your primary policies once your operation, fleet, or portfolio outgrows base coverage.",
  },
];
---

<Layout
  title="Commercial & Business Auto Insurance"
  description="Commercial and business auto coverage from a Florida agency built around fleets, contractors, and operators who can't afford a lapse."
>
  <section class="border-b border-ink/10 bg-ink text-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <p class="text-sm font-semibold uppercase tracking-widest text-brass">Specialty</p>
      <h1 class="mt-3 max-w-2xl font-display text-4xl leading-tight sm:text-5xl">
        Commercial &amp; business auto, quoted by people who understand fleets.
      </h1>
      <p class="mt-5 max-w-xl text-paper/75">
        Most agencies treat commercial auto as a line item. We built this
        agency around it — because a lapsed policy or a bad classification
        can shut a fleet down for weeks. Tell us your vehicles, your
        operation, and your drivers, and a licensed producer will get you
        real numbers.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/get-a-quote"
          class="inline-flex items-center justify-center bg-brass px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-brass-light"
        >
          Get a Quote →
        </a>
        <VoiceWidget class="border-paper/40 text-paper hover:bg-paper/10" />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="font-display text-2xl text-ink sm:text-3xl">What we quote</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {coverages.map((c) => (
        <div class="border border-ink/10 bg-white/40 p-6">
          <h3 class="font-display text-lg text-ink">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate">{c.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-ink/10 bg-paper-2 py-16">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <h2 class="font-display text-2xl text-ink sm:text-3xl">Who this is for</h2>
      <p class="mx-auto mt-4 max-w-2xl text-slate">
        Contractors, delivery and logistics operators, service fleets,
        artisan trades, and any Florida business where a vehicle is a
        working asset — not a commuter car. If your risk needs a real
        classification conversation instead of a dropdown menu, this is
        the line we exist for.
      </p>
      <a
        href="/get-a-quote"
        class="mt-8 inline-flex items-center justify-center bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-brass hover:text-ink"
      >
        Start your quote →
      </a>
    </div>
  </section>
</Layout>
