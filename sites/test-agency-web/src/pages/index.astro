---
import Layout from "../layouts/Layout.astro";
import ProofPoint from "../components/ProofPoint.astro";
import VoiceWidget from "../components/VoiceWidget.astro";
import CanopyConnectWidget from "../components/CanopyConnectWidget.astro";
import { AGENCY_TAGLINE, config, INTAKE_FALLBACKS } from "../config/agency";
---

<Layout title={AGENCY_TAGLINE} description={config.meta_description}>
  <section class="relative overflow-hidden border-b border-ink/10 bg-paper">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 md:grid-cols-2 md:items-center md:py-28">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-brass">
          {config.licensed_states.join("/")} independent insurance agency
        </p>
        <h1 class="mt-4 font-display text-4xl leading-tight text-ink sm:text-5xl md:text-6xl">
          {config.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate">
          {config.hero_description}
        </p>
        <div id="home-canopy-cta" class="mt-8">
          <CanopyConnectWidget
            class="px-8 py-4 text-base"
            label="Get a quote in 1 click — connect your policy →"
          />
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-4">
          <a
            href="/get-a-quote"
            class="text-sm font-semibold text-ink underline decoration-brass decoration-2 underline-offset-4 hover:text-brass"
          >
            Prefer a form? Get a quote manually →
          </a>
          <VoiceWidget />
        </div>
        {INTAKE_FALLBACKS.firstTimeBuyer && (
          <p class="mt-3 text-xs text-slate">
            Buying your first policy?{" "}
            <a
              href="/get-a-quote?path=first_time_buyer#quote-form"
              class="font-semibold text-ink underline decoration-brass decoration-2 underline-offset-4 hover:text-brass"
            >
              Start here →
            </a>
          </p>
        )}
      </div>

      <div class="relative border border-ink/10 bg-ink p-8 text-paper shadow-xl">
        <p class="font-display text-lg text-brass">Why agencies like ours exist</p>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-paper/85">
          {config.why_points.map((point) => <li>— {point}</li>)}
        </ul>
        <p class="mt-6 border-t border-paper/15 pt-4 text-xs text-paper/60">
          A licensed producer reviews and completes every quote. This site
          never binds coverage or collects payment.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="font-display text-2xl text-ink sm:text-3xl">Built to move at your speed</h2>
      <p class="mt-3 text-slate">
        Three things separate {config.agency_name} from the mega-menu agency
        sites: speed, licensing, and specialty.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {config.proof_points.map((p) => (
        <ProofPoint number={p.number} title={p.title} body={p.body} />
      ))}
    </div>
  </section>

  <section class="border-t border-ink/10 bg-ink/95 py-16 text-paper">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-brass">Carriers</p>
      <p class="mt-3 max-w-2xl text-paper/70">
        {config.carriers_note}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
    <h2 class="font-display text-2xl text-ink sm:text-3xl">Ready when you are</h2>
    <p class="mx-auto mt-3 max-w-xl text-slate">
      Tell us about your business or your household once. A licensed producer
      takes it from there.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/get-a-quote"
        class="inline-flex items-center justify-center bg-ink px-6 py-3 text-sm font-semibold text-paper transition-colors hover:bg-brass hover:text-ink"
      >
        Get a Quote →
      </a>
      <VoiceWidget />
    </div>
  </section>
</Layout>
