---
interface Props {
  number: string;
  title: string;
  body: string;
}
const { number, title, body } = Astro.props;
---

<div class="border border-ink/10 bg-white/40 p-6">
  <span class="font-display text-3xl text-brass">{number}</span>
  <h3 class="mt-3 font-display text-xl text-ink">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate">{body}</p>
</div>
