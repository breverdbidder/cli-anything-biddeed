---
// Live Vapi Web SDK integration (@vapi-ai/web). Falls back to the plain tel:
// link -- same behavior as before, just no longer a stub -- when either env
// var is unset at build time, so an agency that hasn't set up Vapi yet still
// gets a working "Talk to us" button.
import { PHONE_TEL, PHONE_DISPLAY, VAPI_PUBLIC_KEY_ENV, VAPI_ASSISTANT_ID_ENV } from "../config/agency";

interface Props {
  class?: string;
  label?: string;
}
const { class: className = "", label = "Talk to us" } = Astro.props;

// import.meta.env keys must be static string literals for Vite to replace
// them at build time -- so both env var names are read from their fixed
// PUBLIC_* slots regardless of what agency.config.json's *_env fields say.
// The *_env fields exist so a generated site's README/dashboard docs can
// point at the right variable name; Vite's static analysis is why the actual
// lookup here can't be dynamic.
const vapiPublicKey = import.meta.env.PUBLIC_VAPI_PUBLIC_KEY;
const vapiAssistantId = import.meta.env.PUBLIC_VAPI_ASSISTANT_ID;
const vapiReady = Boolean(vapiPublicKey && vapiAssistantId);
---

<a
  href={PHONE_TEL}
  data-voice-widget
  data-vapi-ready={vapiReady ? "true" : "false"}
  class:list={[
    "inline-flex items-center gap-2 rounded-none border border-brass px-5 py-3 text-sm font-semibold text-ink transition-colors hover:bg-brass",
    className,
  ]}
  aria-label={`${label}: call ${PHONE_DISPLAY}`}
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
  </svg>
  <span data-voice-widget-label>{label}</span>
</a>

{vapiReady && (
  <script define:vars={{ vapiPublicKey, vapiAssistantId }}>
    // Bundled (not is:inline) so Vite resolves the @vapi-ai/web import.
    // Every VoiceWidget instance on a page shares one Vapi client via
    // window.__vapiClient so a second button on the same page (home hero +
    // home footer CTA, for example) doesn't open two simultaneous calls.
    import("@vapi-ai/web").then(({ default: Vapi }) => {
      const buttons = document.querySelectorAll('[data-voice-widget][data-vapi-ready="true"]');
      const client = window.__vapiClient || (window.__vapiClient = new Vapi(vapiPublicKey));
      let callActive = false;

      client.on("call-start", () => {
        callActive = true;
        buttons.forEach((btn) => (btn.querySelector("[data-voice-widget-label]").textContent = "In call… (click to end)"));
      });
      client.on("call-end", () => {
        callActive = false;
        buttons.forEach((btn) => (btn.querySelector("[data-voice-widget-label]").textContent = btn.dataset.originalLabel || "Talk to us"));
      });
      client.on("error", (err) => {
        console.error("[VoiceWidget] Vapi call error, falling back to tel: link:", err);
        callActive = false;
      });

      buttons.forEach((btn) => {
        btn.dataset.originalLabel = btn.querySelector("[data-voice-widget-label]").textContent || "Talk to us";
        btn.addEventListener("click", (e) => {
          e.preventDefault(); // don't fall through to the tel: href
          if (callActive) {
            client.stop();
          } else {
            client.start(vapiAssistantId);
          }
        });
      });
    }).catch((err) => {
      console.error("[VoiceWidget] Vapi SDK failed to load, tel: link remains active:", err);
    });
  </script>
)}
