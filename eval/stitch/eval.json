{
  "name": "stitchwise_v2_eval",
  "version": "1.0.0",
  "description": "25 binary assertions for StitchWise V2 agent",
  "assertions": [
    { "id": "S01", "desc": "STITCH_API_KEY env var checked on startup", "type": "binary" },
    { "id": "S02", "desc": "Exits with error if STITCH_API_KEY missing", "type": "binary" },
    { "id": "S03", "desc": "StitchToolClient connects to stitch.googleapis.com/mcp", "type": "binary" },
    { "id": "S04", "desc": "create_project returns valid projectId", "type": "binary" },
    { "id": "S05", "desc": "generate() returns screen with HTML URL", "type": "binary" },
    { "id": "S06", "desc": "generate() returns screen with image URL", "type": "binary" },
    { "id": "S07", "desc": "Brand colors injected into prompt (navy #1E3A5F)", "type": "binary" },
    { "id": "S08", "desc": "Brand accent color in prompt (orange #F59E0B)", "type": "binary" },
    { "id": "S09", "desc": "Brand font in prompt (Inter)", "type": "binary" },
    { "id": "S10", "desc": "Background color in prompt (#020617)", "type": "binary" },
    { "id": "S11", "desc": "Circuit breaker: max 3 retries enforced", "type": "binary" },
    { "id": "S12", "desc": "HTML artifact downloaded to stitch-output/", "type": "binary" },
    { "id": "S13", "desc": "Screenshot artifact downloaded to stitch-output/", "type": "binary" },
    { "id": "S14", "desc": "Output directory created if not exists", "type": "binary" },
    { "id": "S15", "desc": "list command returns array of projects", "type": "binary" },
    { "id": "S16", "desc": "export command validates projectId + screenId args", "type": "binary" },
    { "id": "S17", "desc": "dashboard command generates revenue + waitlist + calendar UI", "type": "binary" },
    { "id": "S18", "desc": "landing command generates hero + features + pricing UI", "type": "binary" },
    { "id": "S19", "desc": "--help prints usage without error", "type": "binary" },
    { "id": "S20", "desc": "Unknown command exits with code 1", "type": "binary" },
    { "id": "S21", "desc": "Retry on generation failure (attempt 2 triggered)", "type": "binary" },
    { "id": "S22", "desc": "Download failure throws descriptive error", "type": "binary" },
    { "id": "S23", "desc": "Project name sanitized for filename (spaces to hyphens)", "type": "binary" },
    { "id": "S24", "desc": "MCP config valid JSON with stitch server entry", "type": "binary" },
    { "id": "S25", "desc": "Mobile-first directive present in all prompts", "type": "binary" }
  ]
}
