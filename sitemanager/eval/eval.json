{
  "skill": "sitemanager",
  "version": "1.0.0",
  "description": "Binary assertions for Site Manager / Rehab Monitor output quality.",
  "origin": "Forked from NextAutomation Site Manager v1.0, adapted for Brevard County rehab projects.",
  "scoring": {"pass_threshold": 1.0, "total_assertions": 25, "method": "binary_pass_fail"},
  "tests": [
    {
      "id": "T1_create_project",
      "prompt": "Create project for parcel 2537220000001 with budget 85000. Output JSON.",
      "assertions": [
        {"id": "T1_A1", "description": "Output is valid JSON", "check": "json_parseable", "binary": true},
        {"id": "T1_A2", "description": "Result has project.project_id starting with PRJ-", "check": "field_matches_regex", "field": "project.project_id", "pattern": "^PRJ-[A-F0-9]{6}$", "binary": true},
        {"id": "T1_A3", "description": "Project has 16 phases", "check": "field_count", "field": "project.phases", "count": 16, "binary": true},
        {"id": "T1_A4", "description": "Report has site_health_score 0-100", "check": "field_in_range", "field": "report.site_health_score", "min": 0, "max": 100, "binary": true},
        {"id": "T1_A5", "description": "Report has generated_at ISO timestamp", "check": "field_matches_regex", "field": "report.generated_at", "pattern": "^\\d{4}-\\d{2}-\\d{2}T", "binary": true}
      ]
    },
    {
      "id": "T2_schedule_health",
      "prompt": "Verify schedule stage produces health score, status, and phase tracking.",
      "assertions": [
        {"id": "T2_A1", "description": "Schedule has schedule_health_score 0-100", "check": "field_in_range", "field": "schedule.schedule_health_score", "min": 0, "max": 100, "binary": true},
        {"id": "T2_A2", "description": "Schedule status from valid enum", "check": "field_in_set", "field": "schedule.schedule_status", "values": ["ON_TRACK", "MINOR_DELAYS", "SIGNIFICANT_DELAYS", "MAJOR_DELAYS", "CRITICAL"], "binary": true},
        {"id": "T2_A3", "description": "phases_behind is array", "check": "field_is_array", "field": "schedule.phases_behind", "binary": true},
        {"id": "T2_A4", "description": "phases_complete is array", "check": "field_is_array", "field": "schedule.phases_complete", "binary": true},
        {"id": "T2_A5", "description": "overall_pct between 0 and 1", "check": "field_in_range", "field": "schedule.overall_pct", "min": 0, "max": 1, "binary": true}
      ]
    },
    {
      "id": "T3_safety_checks",
      "prompt": "Verify safety stage runs 10 Brevard-specific checks with scoring.",
      "assertions": [
        {"id": "T3_A1", "description": "Safety has safety_score 0-100", "check": "field_in_range", "field": "safety.safety_score", "min": 0, "max": 100, "binary": true},
        {"id": "T3_A2", "description": "Safety has checks array with 10 items", "check": "field_array_length", "field": "safety.checks", "length": 10, "binary": true},
        {"id": "T3_A3", "description": "critical_findings is array", "check": "field_is_array", "field": "safety.critical_findings", "binary": true},
        {"id": "T3_A4", "description": "action_required is array", "check": "field_is_array", "field": "safety.action_required", "binary": true},
        {"id": "T3_A5", "description": "Each check has severity from LOW|MEDIUM|HIGH|CRITICAL", "check": "nested_field_in_set", "field": "safety.checks.*.severity", "values": ["LOW", "MEDIUM", "HIGH", "CRITICAL"], "binary": true}
      ]
    },
    {
      "id": "T4_composite_report",
      "prompt": "Verify composite report has all scores, action items, and GeoJSON pin.",
      "assertions": [
        {"id": "T4_A1", "description": "Report has site_health_score", "check": "field_in_range", "field": "report.site_health_score", "min": 0, "max": 100, "binary": true},
        {"id": "T4_A2", "description": "Report has action_items array", "check": "field_is_array", "field": "report.action_items", "binary": true},
        {"id": "T4_A3", "description": "Report has schedule_health", "check": "field_exists", "field": "report.schedule_health", "binary": true},
        {"id": "T4_A4", "description": "Report has safety_score", "check": "field_exists", "field": "report.safety_score", "binary": true},
        {"id": "T4_A5", "description": "Report has quality_score", "check": "field_exists", "field": "report.quality_score", "binary": true}
      ]
    },
    {
      "id": "T5_pre1995_safety_flags",
      "prompt": "Create project for a pre-1995 home. Verify polybutylene plumbing flag.",
      "assertions": [
        {"id": "T5_A1", "description": "Safety has at least 1 critical finding", "check": "field_min_count", "field": "safety.critical_findings", "min_count": 1, "binary": true},
        {"id": "T5_A2", "description": "Safety score reduced below 100", "check": "field_in_range", "field": "safety.safety_score", "min": 0, "max": 99, "binary": true},
        {"id": "T5_A3", "description": "Action items include URGENT priority", "check": "nested_field_in_set", "field": "report.action_items.*.priority", "values": ["URGENT", "HIGH", "MEDIUM", "LOW"], "binary": true},
        {"id": "T5_A4", "description": "Report has parcel_id", "check": "field_exists", "field": "report.parcel_id", "binary": true},
        {"id": "T5_A5", "description": "Project has year_built field", "check": "field_exists", "field": "project.year_built", "binary": true}
      ]
    }
  ]
}
