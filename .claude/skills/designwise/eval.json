{
  "skill_id": "designwise",
  "version": "1.0.0",
  "pattern": "design/intelligence",
  "task": "Teardown 3 reference URLs, detect techniques, verify output schema and brand compliance",
  "pass_threshold": 0.8,
  "autoloop_compatible": true,
  "assertions": [
    {
      "id": 1,
      "input": "Teardown https://stripe.com",
      "expected": "Output contains layout_technique field",
      "type": "binary"
    },
    {
      "id": 2,
      "input": "Teardown https://stripe.com",
      "expected": "Output contains animation_library field",
      "type": "binary"
    },
    {
      "id": 3,
      "input": "Teardown https://stripe.com",
      "expected": "Output contains effects[] array",
      "type": "binary"
    },
    {
      "id": 4,
      "input": "Teardown https://stripe.com",
      "expected": "Output contains component_patterns[] array",
      "type": "binary"
    },
    {
      "id": 5,
      "input": "Teardown https://stripe.com",
      "expected": "Output contains source_verified boolean field",
      "type": "binary"
    },
    {
      "id": 6,
      "input": "Detect animation library from page with GSAP CDN script tag",
      "expected": "Returns animation_library: gsap (detected from script src, not visual)",
      "type": "binary"
    },
    {
      "id": 7,
      "input": "Detect animation library from page with no animation scripts",
      "expected": "Returns animation_library: none (not inferred)",
      "type": "binary"
    },
    {
      "id": 8,
      "input": "Detect layout from page using CSS grid",
      "expected": "Returns layout_technique: css-grid (from CSS source)",
      "type": "binary"
    },
    {
      "id": 9,
      "input": "Page with glassmorphism CSS (backdrop-filter: blur)",
      "expected": "Effects array includes glassmorphism",
      "type": "binary"
    },
    {
      "id": 10,
      "input": "Page with no detectable effects",
      "expected": "Effects array is empty [], not null",
      "type": "binary"
    },
    {
      "id": 11,
      "input": "Generate UI component from teardown output",
      "expected": "Output uses Navy #1E3A5F as primary color",
      "type": "binary"
    },
    {
      "id": 12,
      "input": "Generate UI component from teardown output",
      "expected": "Output uses Orange #F59E0B as accent color",
      "type": "binary"
    },
    {
      "id": 13,
      "input": "Generate UI component from teardown output",
      "expected": "Output uses Inter font family",
      "type": "binary"
    },
    {
      "id": 14,
      "input": "Generate UI component from teardown output",
      "expected": "Output uses #020617 as background color",
      "type": "binary"
    },
    {
      "id": 15,
      "input": "Run teardown on URL > 500KB",
      "expected": "Logs truncated, does not fail silently",
      "type": "binary"
    },
    {
      "id": 16,
      "input": "Persist teardown result to Supabase",
      "expected": "Uses teardown_bundles table with url as dedup key",
      "type": "binary"
    },
    {
      "id": 17,
      "input": "Teardown URL with no migration run",
      "expected": "Reports UNTESTED for persistence, does not error silently",
      "type": "binary"
    },
    {
      "id": 18,
      "input": "Page with sticky navigation detected",
      "expected": "Effects array includes sticky-nav",
      "type": "binary"
    },
    {
      "id": 19,
      "input": "Page with hero section detected",
      "expected": "component_patterns includes hero-section",
      "type": "binary"
    },
    {
      "id": 20,
      "input": "Page with pricing table detected",
      "expected": "component_patterns includes pricing-table",
      "type": "binary"
    },
    {
      "id": 21,
      "input": "Teardown output color_system field",
      "expected": "Contains primary, accent, bg sub-keys",
      "type": "binary"
    },
    {
      "id": 22,
      "input": "Teardown output typography field",
      "expected": "Contains font_family sub-key",
      "type": "binary"
    },
    {
      "id": 23,
      "input": "CLI command: cli-anything-designwise teardown <url>",
      "expected": "Uses canonical CLI, does not create alternative script",
      "type": "binary"
    },
    {
      "id": 24,
      "input": "Teardown result detected_at field",
      "expected": "Contains ISO 8601 timestamp",
      "type": "binary"
    },
    {
      "id": 25,
      "input": "Claim CONFIRMED detection without CSS/JS source",
      "expected": "Refuses CONFIRMED tag, uses HYPOTHESIS instead",
      "type": "binary"
    }
  ]
}