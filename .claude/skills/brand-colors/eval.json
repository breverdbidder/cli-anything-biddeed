{
  "skill_id": "brand-colors",
  "version": "1.0.0",
  "pattern": "design/UI",
  "task": "Generate 3 UI components, verify Navy #1E3A5F / Orange #F59E0B / Inter font compliance",
  "pass_threshold": 0.8,
  "autoloop_compatible": true,
  "assertions": [
    {
      "id": 1,
      "input": "Generate a primary button component",
      "expected": "Uses background color #1E3A5F (navy)",
      "type": "binary"
    },
    {
      "id": 2,
      "input": "Generate a primary button component",
      "expected": "Uses accent #F59E0B for hover or CTA variant",
      "type": "binary"
    },
    {
      "id": 3,
      "input": "Generate a navbar component",
      "expected": "Background is #1E3A5F or #020617, not black or white",
      "type": "binary"
    },
    {
      "id": 4,
      "input": "Generate any component",
      "expected": "Includes Inter in font-family stack",
      "type": "binary"
    },
    {
      "id": 5,
      "input": "Generate a card component",
      "expected": "Dark background uses #020617, not #000000",
      "type": "binary"
    },
    {
      "id": 6,
      "input": "Generate a badge with brand color",
      "expected": "Orange badge uses exactly #F59E0B",
      "type": "binary"
    },
    {
      "id": 7,
      "input": "Generate component with Tailwind",
      "expected": "Does not use tailwind blue-900 as navy substitute",
      "type": "binary"
    },
    {
      "id": 8,
      "input": "Generate any UI component",
      "expected": "Includes Brand Audit block in output",
      "type": "binary"
    },
    {
      "id": 9,
      "input": "Brand audit on component with #1D3A5F",
      "expected": "Flags as FAIL -- wrong navy hex",
      "type": "binary"
    },
    {
      "id": 10,
      "input": "Brand audit on component with Inter font",
      "expected": "Reports font as PASS",
      "type": "binary"
    },
    {
      "id": 11,
      "input": "Brand audit on component using system-ui font",
      "expected": "Reports font as FAIL",
      "type": "binary"
    },
    {
      "id": 12,
      "input": "Generate dark dashboard layout",
      "expected": "Uses #020617 as base background",
      "type": "binary"
    },
    {
      "id": 13,
      "input": "Generate text on dark background",
      "expected": "Reports contrast ratio >= 4.5:1 (WCAG AA)",
      "type": "binary"
    },
    {
      "id": 14,
      "input": "Generate component with inline hex #1E3A5F",
      "expected": "Recommends CSS variable or Tailwind config instead",
      "type": "binary"
    },
    {
      "id": 15,
      "input": "Generate alert component in orange",
      "expected": "Uses #F59E0B not amber-400 (#FBBF24)",
      "type": "binary"
    },
    {
      "id": 16,
      "input": "Generate login page",
      "expected": "Background defaults to dark theme (#020617)",
      "type": "binary"
    },
    {
      "id": 17,
      "input": "Verify Tailwind config has brand colors",
      "expected": "Checks for navy and amber-400 in tailwind.config.js",
      "type": "binary"
    },
    {
      "id": 18,
      "input": "Generate a quick prototype without brand audit request",
      "expected": "Still includes brand audit block",
      "type": "binary"
    },
    {
      "id": 19,
      "input": "Use brand colors in a chart component",
      "expected": "Series colors use #1E3A5F and #F59E0B",
      "type": "binary"
    },
    {
      "id": 20,
      "input": "Generate a footer component",
      "expected": "Background matches navbar brand color",
      "type": "binary"
    },
    {
      "id": 21,
      "input": "Generate typography scale",
      "expected": "Inter is first font in stack",
      "type": "binary"
    },
    {
      "id": 22,
      "input": "White text on #020617 background",
      "expected": "Reports contrast ratio > 15:1 (PASS)",
      "type": "binary"
    },
    {
      "id": 23,
      "input": "Generate a loading spinner",
      "expected": "Spinner color uses brand palette (navy or orange)",
      "type": "binary"
    },
    {
      "id": 24,
      "input": "Component uses #1E3A5F as text color on dark bg",
      "expected": "Warns about potential low contrast",
      "type": "binary"
    },
    {
      "id": 25,
      "input": "Generate component with 3 color variants",
      "expected": "All variants derived from brand palette, not arbitrary colors",
      "type": "binary"
    }
  ]
}