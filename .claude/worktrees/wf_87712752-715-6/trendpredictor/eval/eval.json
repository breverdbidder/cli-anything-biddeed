{
  "skill": "trendpredictor",
  "version": "1.0.0",
  "description": "Binary assertions for Market Trend Predictor output quality. Karpathy self-improvement loop.",
  "origin": "Forked from NextAutomation Market Trend Predictor v1.0, adapted for Brevard County + Mapbox heatmaps.",
  "scoring": {
    "pass_threshold": 1.0,
    "total_assertions": 25,
    "method": "binary_pass_fail"
  },
  "tests": [
    {
      "id": "T1_single_submarket",
      "prompt": "Analyze ZIP 32937 (Satellite Beach) with 12-month horizon. Output JSON.",
      "expected_output": "Complete analysis with 6 stages and direction score",
      "assertions": [
        {"id": "T1_A1", "description": "Output is valid JSON", "check": "json_parseable", "binary": true},
        {"id": "T1_A2", "description": "Result has 'stages' with at least 5 sub-objects", "check": "field_min_count", "field": "stages", "min_count": 5, "binary": true},
        {"id": "T1_A3", "description": "Result has zip_code matching 32937", "check": "field_equals", "field": "zip_code", "value": "32937", "binary": true},
        {"id": "T1_A4", "description": "Result has analyzed_at in ISO format", "check": "field_matches_regex", "field": "analyzed_at", "pattern": "^\\d{4}-\\d{2}-\\d{2}T", "binary": true},
        {"id": "T1_A5", "description": "Result has elapsed_seconds as positive number", "check": "field_positive_number", "field": "elapsed_seconds", "binary": true}
      ]
    },
    {
      "id": "T2_prediction_stage",
      "prompt": "Verify prediction stage has direction score, label, timing action, and GeoJSON feature.",
      "expected_output": "Prediction with score -10 to +10, label, action, geojson",
      "assertions": [
        {"id": "T2_A1", "description": "Direction score between -10 and +10", "check": "field_in_range", "field": "stages.prediction.direction_score", "min": -10, "max": 10, "binary": true},
        {"id": "T2_A2", "description": "Direction label from valid enum", "check": "field_in_set", "field": "stages.prediction.direction_label", "values": ["STRONG_TAILWIND", "MILD_TAILWIND", "NEUTRAL", "MILD_HEADWIND", "STRONG_HEADWIND"], "binary": true},
        {"id": "T2_A3", "description": "Timing action from BUY|BUILD|HOLD|SELL", "check": "field_in_set", "field": "stages.prediction.timing_action", "values": ["BUY", "BUILD", "HOLD", "SELL"], "binary": true},
        {"id": "T2_A4", "description": "GeoJSON feature exists with Point geometry", "check": "field_equals", "field": "stages.prediction.geojson_feature.geometry.type", "value": "Point", "binary": true},
        {"id": "T2_A5", "description": "Confidence between 0.0 and 1.0", "check": "field_in_range", "field": "stages.prediction.confidence", "min": 0.0, "max": 1.0, "binary": true}
      ]
    },
    {
      "id": "T3_cycle_stage",
      "prompt": "Verify cycle stage maps to valid phase with strategy.",
      "expected_output": "Cycle with phase, confidence, strategy, next phase",
      "assertions": [
        {"id": "T3_A1", "description": "Current phase from RECOVERY|EXPANSION|HYPER_SUPPLY|RECESSION", "check": "field_in_set", "field": "stages.cycle.current_phase", "values": ["RECOVERY", "EXPANSION", "HYPER_SUPPLY", "RECESSION"], "binary": true},
        {"id": "T3_A2", "description": "Phase confidence between 0 and 1", "check": "field_in_range", "field": "stages.cycle.phase_confidence", "min": 0.0, "max": 1.0, "binary": true},
        {"id": "T3_A3", "description": "Strategy is non-empty string", "check": "field_not_null", "field": "stages.cycle.strategy", "binary": true},
        {"id": "T3_A4", "description": "Next phase from valid enum", "check": "field_in_set", "field": "stages.cycle.next_phase", "values": ["RECOVERY", "EXPANSION", "HYPER_SUPPLY", "RECESSION"], "binary": true},
        {"id": "T3_A5", "description": "Transition signals is array", "check": "field_is_array", "field": "stages.cycle.transition_signals", "binary": true}
      ]
    },
    {
      "id": "T4_signal_breakdown",
      "prompt": "Verify SIGNAL framework produces weighted breakdown with all 8 signals.",
      "expected_output": "Signal breakdown with rent_trend, absorption, supply, employment, migration, affordability, foreclosure, rates",
      "assertions": [
        {"id": "T4_A1", "description": "Signal breakdown has rent_trend", "check": "field_exists", "field": "stages.prediction.signal_breakdown.rent_trend", "binary": true},
        {"id": "T4_A2", "description": "Signal breakdown has absorption", "check": "field_exists", "field": "stages.prediction.signal_breakdown.absorption", "binary": true},
        {"id": "T4_A3", "description": "Signal breakdown has supply_pipeline", "check": "field_exists", "field": "stages.prediction.signal_breakdown.supply_pipeline", "binary": true},
        {"id": "T4_A4", "description": "Signal breakdown has foreclosure_volume", "check": "field_exists", "field": "stages.prediction.signal_breakdown.foreclosure_volume", "binary": true},
        {"id": "T4_A5", "description": "Each signal has score, weight, and weighted fields", "check": "nested_field_exists", "field": "stages.prediction.signal_breakdown.rent_trend.weighted", "binary": true}
      ]
    },
    {
      "id": "T5_geojson_heatmap",
      "prompt": "Verify GeoJSON feature has correct Mapbox heatmap properties.",
      "expected_output": "GeoJSON Point with heatmap_weight 0-1 and all properties",
      "assertions": [
        {"id": "T5_A1", "description": "GeoJSON type is Feature", "check": "field_equals", "field": "stages.prediction.geojson_feature.type", "value": "Feature", "binary": true},
        {"id": "T5_A2", "description": "Coordinates array has 2 elements (lng, lat)", "check": "field_array_length", "field": "stages.prediction.geojson_feature.geometry.coordinates", "length": 2, "binary": true},
        {"id": "T5_A3", "description": "heatmap_weight between 0 and 1", "check": "field_in_range", "field": "stages.prediction.geojson_feature.properties.heatmap_weight", "min": 0, "max": 1, "binary": true},
        {"id": "T5_A4", "description": "Properties has zip_code", "check": "field_exists", "field": "stages.prediction.geojson_feature.properties.zip_code", "binary": true},
        {"id": "T5_A5", "description": "Properties has timing_action", "check": "field_exists", "field": "stages.prediction.geojson_feature.properties.timing_action", "binary": true}
      ]
    }
  ]
}
