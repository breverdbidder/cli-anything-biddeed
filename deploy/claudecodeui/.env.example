# claudecodeui (CloudCLI) production env — place at repo root as .env
SERVER_PORT=3001
HOST=0.0.0.0
# If your claude CLI is not on PATH for the service user, set it:
# CLAUDE_CLI_PATH=/usr/local/bin/claude
# Auth DB (users, api keys, github tokens, push subscriptions) — keep on persistent disk:
DATABASE_PATH=/opt/claudecodeui-data/auth.db
CONTEXT_WINDOW=160000
VITE_CONTEXT_WINDOW=160000
